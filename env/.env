# true=Run the tests in headless mode, false=Run the tests in a browser window
HEADLESS_MODE=false

# Enable Soft Assertions
SOFT_ASSERT_MODE=false

# Debug Mode settings
DEBUG_MODE=false

# Where to save the trace record
REPORTS_DIR=reports/local

# Recording playwright trace during test run
TRACE_LEVEL=on

# Controlling the logger
LOG_LEVEL=verbose

PARALLEL_TEST_COUNT=2